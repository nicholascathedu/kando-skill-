                "iconTheme": "material-symbols-rounded",
                "type": "button",
                "angle": 0,
                "selectWorkflow": {
                  "actions": [
                    {
                      "type": "close-menu"
                    },
                    {
                      "type": "execute-command",
                      "command": "wt -d \"%USERPROFILE%\\Projects\" claude",
                      "detached": true
